{
  "name": "mralleys-course-api",
  "version": "0.1.0",
  "private": true,
  "description": "巷弄故事館 線上寫歌課 API（Cloudflare Worker + D1）",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply mralleys-course --local",
    "db:migrate:remote": "wrangler d1 migrations apply mralleys-course --remote",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
